# The Scorecard backend, kept running by systemd.

[Unit]
Description=Scorecard platform (FastAPI backend)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=scorecard
Group=scorecard
WorkingDirectory=/opt/scorecard/backend
EnvironmentFile=/etc/scorecard/scorecard.env

# One worker process: each process builds one scorecard at a time on a background thread, and one is all this machine's memory needs to carry.
ExecStart=/opt/scorecard/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header

Restart=on-failure
RestartSec=5
# A build in progress is abandoned on stop.
TimeoutStopSec=30

# The service can write to its data folder and nowhere else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/scorecard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
