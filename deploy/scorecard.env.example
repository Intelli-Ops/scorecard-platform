# Settings for the Scorecard service. install.sh copies this file to
# /etc/scorecard/scorecard.env on the first install and fills in the database
# password. Later installs (updates) never overwrite it.
#
# One KEY=value per line, no spaces around "=", no quotes, and comments on
# their own lines only: systemd reads this file too, and it keeps anything
# after the value, a "#" included, as part of the value.
#
# After editing:  sudo systemctl restart scorecard

# The database. A plain mysql:// address: the app adds the driver and the
# utf8mb4 character set itself. If the password has characters such as
# @ : / ? # % in it, write them URL-encoded (@ becomes %40).
SCORECARD_DB=mysql://scorecard:CHANGE_ME@127.0.0.1/scorecard

# Uploaded files, build results and the Excel cache.
SCORECARD_DATA=/var/lib/scorecard

# Sign-ins outside these hours, in this time zone, are flagged on the
# Activity screen.
SCORECARD_TIMEZONE=Asia/Karachi
SCORECARD_WORK_HOURS=7-21

# 0 hides the /docs API listing. Keep it 0 on a server.
SCORECARD_API_DOCS=0

# Empty: nginx serves the page and the API from one address, so no other
# origin needs to call the API.
SCORECARD_CORS_ORIGINS=

# The largest single uploaded file, in MB. nginx's client_max_body_size in
# /etc/nginx/sites-available/scorecard must be at least this.
SCORECARD_MAX_UPLOAD_MB=1024

# The code under /opt/scorecard is read-only to the service; install.sh
# compiles it ahead of time instead.
PYTHONDONTWRITEBYTECODE=1
