# Settings for the Scorecard service.

# The database.
SCORECARD_DB=mysql://scorecard:CHANGE_ME@127.0.0.1/scorecard

# 0: the app does not change the database's schema itself.
SCORECARD_AUTO_MIGRATE=0

# The address people open the app at.
SCORECARD_PUBLIC_URL=

# Mail, for the one-time codes (email confirmation, password reset).
SCORECARD_SMTP_HOST=
SCORECARD_SMTP_PORT=587
SCORECARD_SMTP_USER=
SCORECARD_SMTP_PASSWORD=
# The From address.
SCORECARD_MAIL_FROM=

# Uploaded files, build results and the Excel cache.
SCORECARD_DATA=/var/lib/scorecard

# 1: the API refuses anything that did not arrive over HTTPS, so passwords never cross the network unencrypted.
SCORECARD_REQUIRE_HTTPS=1

# The business's time zone.
SCORECARD_TIMEZONE=Asia/Karachi
SCORECARD_WORK_HOURS=7-21

# 0 hides the /docs API listing.
SCORECARD_API_DOCS=0

# Empty: nginx serves the page and the API from one address, so no other origin needs to call the API.
SCORECARD_CORS_ORIGINS=

# The largest single uploaded file, in MB.
SCORECARD_MAX_UPLOAD_MB=1024

# The code under /opt/scorecard is read-only to the service.
PYTHONDONTWRITEBYTECODE=1
