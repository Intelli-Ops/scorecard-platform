#!/usr/bin/env bash
# The app's server commands (backend/app/manage.py), run as the service account with the service's own settings.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "run it with sudo: sudo scorecard-manage $*" >&2; exit 1; }
set -a; . /etc/scorecard/scorecard.env; set +a
if [[ -f /etc/scorecard/migrate.env ]]; then
  set -a; . /etc/scorecard/migrate.env; set +a
fi
cd /opt/scorecard/backend
exec runuser -u scorecard -- /opt/scorecard/.venv/bin/python -m app.manage "$@"
